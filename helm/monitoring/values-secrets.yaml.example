# ── helm/monitoring/values-secrets.yaml.example ──────────────────────────────
#
# Copia este fichero como values-secrets.yaml y rellena los valores reales.
# values-secrets.yaml está en .gitignore y NUNCA debe subirse al repositorio.
#
# Para instalar el stack con los secrets:
#   helm install monitoring prometheus-community/kube-prometheus-stack \
#     --namespace monitoring --create-namespace \
#     -f helm/monitoring/values-prometheus.yaml \
#     -f helm/monitoring/values-secrets.yaml
#
# Para actualizar solo los secrets sin tocar el resto:
#   helm upgrade monitoring prometheus-community/kube-prometheus-stack \
#     --namespace monitoring \
#     -f helm/monitoring/values-prometheus.yaml \
#     -f helm/monitoring/values-secrets.yaml

alertmanager:
  config:
    receivers:
      - name: telegram
        telegram_configs:
          - bot_token: "AQUI_EL_TOKEN_DEL_BOT"   # BotFather → /newbot
            chat_id: 0                             # ID del chat (envía /start al bot y consulta la API)
            parse_mode: HTML
            message: |
              🚨 <b>[{{ .Status | toUpper }}] DIRA – {{ .CommonLabels.alertname }}</b>
              {{- range .Alerts }}
              📋 <b>{{ .Annotations.summary }}</b>
              {{- if .Annotations.description }}
              {{ .Annotations.description }}
              {{- end }}
              {{- end }}

grafana:
  adminPassword: "AQUI_LA_PASSWORD_DE_GRAFANA"
